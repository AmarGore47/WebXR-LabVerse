# LabVerse Server Environment Configuration
# Copy this file to .env and configure your secrets.
# NEVER commit .env to version control or expose GEMINI_API_KEY in frontend bundles.

# Server Port
PORT=3001

# Node Environment ('development' | 'production' | 'test')
NODE_ENV=development

# Gemini API Key (Server-side ONLY - do NOT prefix with VITE_)
# Obtain an API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=AQ.Ab8RN6IIWOLs17IBMLgJlgpI8-uBMPg-ouO4tk36OOpdH6LDoA

# Gemini Model Selection (default: gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Allowed Frontend Origins for CORS (comma-separated)
CORS_ORIGINS=http://localhost:5173,https://localhost:5173,http://127.0.0.1:5173,https://127.0.0.1:5173

# Rate Limiting Configuration
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=20

# AI Request Timeout in Milliseconds
AI_REQUEST_TIMEOUT_MS=10000
